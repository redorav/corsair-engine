FullscreenTriangle:
  entrypoint: CopyTextureVS
  stage: Vertex

CopyTextureColorPS:
  entrypoint: CopyTexturePS
  stage: Pixel

CopyTextureDepth:
  entrypoint: CopyTexturePS
  stage: Pixel
  defines: "DEPTH"
  
CopyTextureCubemap:
  entrypoint: CopyTexturePS
  stage: Pixel
  defines: "CUBEMAP"

CopyTextureCubemapDepth:
  entrypoint: CopyTexturePS
  stage: Pixel
  defines: ["DEPTH", "CUBEMAP"]